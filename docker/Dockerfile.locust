FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Bornes explicites plutot qu'une version figee : le POC reste lisible et reproductible.
RUN pip install --no-cache-dir "locust>=2.20,<3"

RUN useradd -m -u 1000 locust \
 && mkdir -p /resultats \
 && chown -R locust:locust /resultats

COPY docker/entrypoint-locust.sh /usr/local/bin/entrypoint-locust.sh
RUN chmod +x /usr/local/bin/entrypoint-locust.sh

USER locust
WORKDIR /work

ENTRYPOINT ["/usr/local/bin/entrypoint-locust.sh"]
